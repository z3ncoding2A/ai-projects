# systemd USER unit: install at ~/.config/systemd/user/voice-assistant.service
# Enable:  systemctl --user enable --now voice-assistant
# Logs:    journalctl --user -u voice-assistant -f
[Unit]
Description=Sovereign Hyprland Voice Assistant
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/ai-projects/ai-voice-assistant
ExecStart=%h/ai-projects/ai-voice-assistant/.venv/bin/python -m execution.daemon
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=LD_LIBRARY_PATH=/usr/local/lib/ollama/cuda_v12
# WAYLAND_DISPLAY / XDG_RUNTIME_DIR are normally inherited if Hyprland runs
# `systemctl --user import-environment WAYLAND_DISPLAY XDG_RUNTIME_DIR` at startup.
# Uncomment and adjust if the daemon cannot reach the compositor:
# Environment=WAYLAND_DISPLAY=wayland-1
# Environment=XDG_RUNTIME_DIR=/run/user/1000

[Install]
WantedBy=graphical-session.target
