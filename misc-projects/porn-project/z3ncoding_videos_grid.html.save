    <a href="#" id="back-to-top" title="Back to Top">↑</a>

    <script>
        const searchInput = document.getElementById('search-input');
        const sortSelect = document.getElementById('sort-select');
        const videoGrid = document.getElementById('video-grid');
        let videoCards = Array.from(document.querySelectorAll('.video-card'));
        const visibleCount = document.getElementById('visible-count');
        const backToTop = document.getElementById('back-to-top');
        
        let currentTab = 'none';
        let categories = JSON.parse(localStorage.getItem('z3ncoding_categories') || '{}');
        let deleted = JSON.parse(localStorage.getItem('z3ncoding_deleted') || '[]');

        function handleImageError(img) {
            img.style.display = 'none';
            const wrapper = img.parentElement;
            const fallback = document.createElement('div');
            fallback.className = 'thumbnail broken';
            fallback.innerText = 'Image Unavailable';
            wrapper.prepend(fallback);
        }

        function setTab(tab) {
            currentTab = tab;
            document.querySelectorAll('.tab-btn').forEach(btn => {
                const btnText = btn.innerText.toLowerCase();
                if (tab === 'none') {
                    btn.classList.toggle('active', btnText === 'main list');
                } else {
                    btn.classList.toggle('active', btnText.includes(tab));
                }
            });
            filterAndSort();
            window.scrollTo(0, 0);
        }

        function categorize(viewkey, category) {
            if (category === 'none') {
                delete categories[viewkey];
            } else {
                categories[viewkey] = category;
            }
            localStorage.setItem('z3ncoding_categories', JSON.stringify(categories));
            filterAndSort();
        }

        function deleteVideo(viewkey) {
            if (confirm('Remove video from UI? (Copy to blacklist.txt for permanent removal)')) {
                if (!deleted.includes(viewkey)) {
                    deleted.push(viewkey);
                    localStorage.setItem('z3ncoding_deleted', JSON.stringify(deleted));
                    filterAndSort();
                }
            }
        }

        function toggleModal(id) {
            if (id === 'export-modal') {
                document.getElementById('export-textarea').value = JSON.stringify(categories, null, 2);
            } else if (id === 'blacklist-modal') {
                document.getElementById('blacklist-textarea').value = deleted.join('\n');
            }
            document.getElementById(id).classList.add('visible');
            document.getElementById('modal-overlay').classList.add('visible');
        }

        function closeModals() {
            document.querySelectorAll('.modal').forEach(m => m.classList.remove('visible'));
            document.getElementById('modal-overlay').classList.remove('visible');
        }

        function clearBlacklist() {
            if (confirm('Clear local blacklist?')) {
                deleted = [];
                localStorage.setItem('z3ncoding_deleted', JSON.stringify(deleted));
                filterAndSort();
                closeModals();
            }
        }

        function filterAndSort() {
            const query = searchInput.value.toLowerCase().trim();
            const sortMode = sortSelect.value;
            let count = 0;

            videoCards.sort((a, b) => {
                if (sortMode === 'title-az') return a.getAttribute('data-title').localeCompare(b.getAttribute('data-title'));
                if (sortMode === 'views-desc') return parseInt(b.getAttribute('data-views')) - parseInt(a.getAttribute('data-views'));
                if (sortMode === 'duration-desc') return parseInt(b.getAttribute('data-duration')) - parseInt(a.getAttribute('data-duration'));
                return parseInt(a.getAttribute('data-index')) - parseInt(b.getAttribute('data-index'));
            });

            videoCards.forEach(card => videoGrid.appendChild(card));

            videoCards.forEach(card => {
                const title = card.getAttribute('data-title');
                const viewkey = card.getAttribute('data-viewkey');
                const hardcodedCat = card.getAttribute('data-category');
                const cardCat = categories[viewkey] || hardcodedCat || 'none';
                
                const isDeleted = deleted.includes(viewkey);
                const matchesQuery = title.includes(query);
                const matchesTab = (cardCat === currentTab);

                if (!isDeleted && matchesQuery && matchesTab) {
                    card.classList.remove('hidden');
                    count++;
                } else {
                    card.classList.add('hidden');
                }
            });

            visibleCount.textContent = count;
        }

        searchInput.addEventListener('input', filterAndSort);
        sortSelect.addEventListener('change', filterAndSort);

        window.addEventListener('scroll', () => {
            if (window.scrollY > 500) backToTop.classList.add('visible');
            else backToTop.classList.remove('visible');
        });
        
        filterAndSort();
    </script>
</body>
</html>
    