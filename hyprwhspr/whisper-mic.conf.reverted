# Parametric EQ optimization chain for DIY headphone microphone to dictation tools
context.modules = [
    { name = libpipewire-module-filter-chain
        args = {
            node.description = "whisper dictation mic"
            node.name        = "whisper dictation mic"
            
            # The capture properties define the input of the filter chain.
            capture.props = {
                node.passive = true
                audio.position = [ FL FR ]
                target.object = "alsa_input.pci-0000_00_1f.3.analog-stereo"
            }
            
            # The playback properties define the output of the filter chain.
            # This is where we define the source for the system.
            playback.props = {
                media.class      = Audio/Source
                node.name        = "whisper dictation mic"
                node.description = "whisper dictation mic"
                node.passive     = true
                audio.rate       = 16000
            }
            
            filter.graph = {
                nodes = [
                    # 1. High-pass filter: Eliminate low frequency breathing/room rumble below 150Hz
                    { type = builtin name = hp_stage label = bq_highpass control = { "Freq" = 150.0 "Q" = 1.0 } }
                    
                    # 2. Peaking filter: Cut the plastic "cup-like" echoing boxiness at 400Hz
                    { type = builtin name = cut_stage label = bq_peaking control = { "Freq" = 400.0 "Q" = 1.2 "Gain" = -4.0 } }
                    
                    # 3. Peaking filter: Boost lower articulation presence at 1.5kHz
                    { type = builtin name = boost1 label = bq_peaking control = { "Freq" = 1500.0 "Q" = 1.0 "Gain" = 1.5 } }
                    
                    # 4. Peaking filter: Heavy boost at 2.8kHz where Whisper tracks hard consonants
                    { type = builtin name = boost2 label = bq_peaking control = { "Freq" = 2800.0 "Q" = 1.2 "Gain" = 2.5 } }
                    
                    # 5. Peaking filter: Boost upper clarity accents at 4.2kHz
                    { type = builtin name = boost3 label = bq_peaking control = { "Freq" = 4200.0 "Q" = 1.0 "Gain" = 2.0 } }
                    
                    # 6. Low-pass filter: Dead-cut everything above 6kHz to wipe out cable static line hiss
                    { type = builtin name = lp_stage label = bq_lowpass control = { "Freq" = 6000.0 "Q" = 1.0 } }
                ]
                links = [
                    { output = "hp_stage:Out"   input = "cut_stage:In" }
                    { output = "cut_stage:Out"  input = "boost1:In" }
                    { output = "boost1:Out"     input = "boost2:In" }
                    { output = "boost2:Out"     input = "boost3:In" }
                    { output = "boost3:Out"     input = "lp_stage:In" }
                ]
            }
        }
    }
]